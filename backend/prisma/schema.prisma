generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  EMPLOYEE
}

enum UserStatus {
  ACTIVE
  DISABLED
}

enum PartnerType {
  CUSTOMER
  SUPPLIER
  PARTNER
  OTHER
}

enum PartnerStatus {
  ACTIVE
  DISABLED
}

enum DocumentStatus {
  NORMAL
  ARCHIVED
  DELETED
}

enum DocumentLogAction {
  UPLOAD
  VIEW_DETAIL
  DOWNLOAD
  EDIT_INFO
  UPLOAD_VERSION
  DELETE
  RESTORE
}

enum DocumentLogResult {
  SUCCESS
  FAILURE
}

enum FinancePackageStatus {
  DRAFT
  READY
  EXPORTED
}

enum FinanceAnalysisJobStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
}

enum FinanceSuggestionStatus {
  PENDING
  CONFIRMED
  REJECTED
}

enum FinanceAnalysisSource {
  RULES
  AI
}

enum FinanceMaterialType {
  REIMBURSEMENT_FORM
  INVOICE
  PAYMENT_FORM
  TICKET
  CONTRACT
  BANK_RECEIPT
  OTHER
}

enum BusinessMatterType {
  PROJECT
  CONTRACT
  REIMBURSEMENT
  LOAN
  PROCUREMENT
  OTHER
}

enum BusinessMatterStatus {
  PLANNING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum BusinessTaskStatus {
  TODO
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum BusinessTaskPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum BusinessStageStatus {
  PLANNED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum BusinessMilestoneStatus {
  PLANNED
  COMPLETED
  CANCELLED
}

enum BusinessIssueKind {
  RISK
  ISSUE
}

enum BusinessIssueSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum BusinessIssueStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CANCELLED
}

enum BusinessFollowUpMethod {
  CALL
  WECHAT
  EMAIL
  MEETING
  ONSITE
  OTHER
}

enum BusinessFinanceKind {
  LOAN
  REIMBURSEMENT
}

enum BusinessFinanceStatus {
  DRAFT
  PENDING
  APPROVED
  PAID
  SETTLED
  REJECTED
  CANCELLED
}

enum BusinessContractStatus {
  DRAFT
  ACTIVE
  EXPIRED
  TERMINATED
}

enum BusinessActivityAction {
  MATTER_CREATED
  MATTER_UPDATED
  MATTER_DELETED
  TASK_CREATED
  TASK_UPDATED
  TASK_COMPLETED
  TASK_DELETED
  FOLLOW_UP_CREATED
  CONTRACT_UPDATED
  CONTRACT_DELETED
  FINANCE_CREATED
  FINANCE_UPDATED
  FINANCE_DELETED
  FINANCE_DOCUMENT_ATTACHED
  FINANCE_DOCUMENT_DETACHED
  TASK_DOCUMENT_ATTACHED
  TASK_DOCUMENT_DETACHED
  FOLLOW_UP_DOCUMENT_ATTACHED
  FOLLOW_UP_DOCUMENT_DETACHED
  ISSUE_CREATED
  ISSUE_UPDATED
  ISSUE_DELETED
  ISSUE_DOCUMENT_ATTACHED
  ISSUE_DOCUMENT_DETACHED
}

enum AssetReservationStatus {
  PENDING
  APPROVED
  ACTIVE
  COMPLETED
  CANCELLED
  REJECTED
  EXPIRED
}

enum AssetBorrowStatus {
  REQUESTED
  APPROVED
  ACTIVE
  RETURN_PENDING
  RETURNED
  REJECTED
  CANCELLED
}

enum AssetHandoverType {
  CHECKOUT
  RETURN
  TRANSFER
}

enum AssetHandoverStatus {
  DRAFT
  CONFIRMED
  CANCELLED
}

enum AssetTransferStatus {
  PENDING
  APPROVED
  IN_TRANSIT
  COMPLETED
  REJECTED
  CANCELLED
}

enum AssetInventoryScopeType {
  ORGANIZATION
  DEPARTMENT
  LOCATION
  PROJECT
  ASSET_TYPE
  ASSET_LIST
}

enum AssetInventoryStatus {
  OPEN
  COMPLETED
  CANCELLED
}

enum AssetInventoryResult {
  NORMAL
  SURPLUS
  MISSING
  LOCATION_MISMATCH
  STATUS_MISMATCH
  OWNER_MISMATCH
}

enum AssetMaintenanceType {
  REPAIR
  MAINTENANCE
  INSPECTION
}

enum AssetMaintenanceStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum AssetAnomalyType {
  SURPLUS
  MISSING
  LOCATION_MISMATCH
  STATUS_MISMATCH
  OWNER_MISMATCH
  DAMAGE
  OTHER
}

enum AssetAnomalySeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum AssetAnomalyStatus {
  OPEN
  RESOLVED
}

enum AssetExitType {
  SCRAPPED
  LOST
  SOLD
  TRANSFERRED
  DONATED
  CROSS_COMPANY_TRANSFER
}

enum AssetExitStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum ApprovalBusinessType {
  ASSET_INTAKE
  ASSET_RESERVATION
  ASSET_BORROW
  ASSET_TRANSFER
  ASSET_EXIT
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum ApprovalActionType {
  SUBMIT
  APPROVE
  REJECT
  CANCEL
}

enum OperationResult {
  SUCCESS
  FAILURE
}

model User {
  id                                String                        @id @default(uuid())
  username                          String                        @unique
  passwordHash                      String                        @map("password_hash")
  realName                          String                        @map("real_name")
  role                              UserRole                      @default(EMPLOYEE)
  status                            UserStatus                    @default(ACTIVE)
  organizationId                    String?                       @map("organization_id")
  departmentId                      String?                       @map("department_id")
  phone                             String?
  email                             String?
  createdAt                         DateTime                      @default(now()) @map("created_at")
  updatedAt                         DateTime                      @updatedAt @map("updated_at")
  deletedAt                         DateTime?                     @map("deleted_at")
  organization                      Organization?                 @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  department                        Department?                   @relation(fields: [departmentId], references: [id])
  organizationMemberships           OrganizationMember[]
  roleBindings                      UserRoleBinding[]
  dataScopes                        UserDataScope[]
  sessions                          AuthSession[]
  createdTags                       Tag[]                         @relation("TagCreatedBy")
  createdDocuments                  Document[]                    @relation("DocumentCreatedBy")
  uploadedVersions                  DocumentVersion[]             @relation("VersionUploadedBy")
  documentLogs                      DocumentLog[]
  financePackageTasks               FinancePackageTask[]          @relation("FinancePackageCreatedBy")
  financePackageExports             FinancePackageExport[]        @relation("FinancePackageExportedBy")
  financeAnalysisJobs               FinanceAnalysisJob[]          @relation("FinanceAnalysisCreatedBy")
  ownedBusinessMatters              BusinessMatter[]              @relation("BusinessMatterOwner")
  createdBusinessMatters            BusinessMatter[]              @relation("BusinessMatterCreatedBy")
  assignedBusinessTasks             BusinessMatterTask[]          @relation("BusinessTaskAssignee")
  createdBusinessTasks              BusinessMatterTask[]          @relation("BusinessTaskCreatedBy")
  completedBusinessTasks            BusinessMatterTask[]          @relation("BusinessTaskCompletedBy")
  cancelledBusinessTasks            BusinessMatterTask[]          @relation("BusinessTaskCancelledBy")
  ownedBusinessMatterStages         BusinessMatterStage[]         @relation("BusinessStageOwner")
  createdBusinessMatterStages       BusinessMatterStage[]         @relation("BusinessStageCreatedBy")
  ownedBusinessMatterMilestones     BusinessMatterMilestone[]     @relation("BusinessMilestoneOwner")
  createdBusinessMatterMilestones   BusinessMatterMilestone[]     @relation("BusinessMilestoneCreatedBy")
  completedBusinessMatterMilestones BusinessMatterMilestone[]     @relation("BusinessMilestoneCompletedBy")
  ownedBusinessMatterIssues         BusinessMatterIssue[]         @relation("BusinessIssueOwner")
  createdBusinessMatterIssues       BusinessMatterIssue[]         @relation("BusinessIssueCreatedBy")
  resolvedBusinessMatterIssues      BusinessMatterIssue[]         @relation("BusinessIssueResolvedBy")
  createdBusinessFollowUps          BusinessMatterFollowUp[]      @relation("BusinessFollowUpCreatedBy")
  assignedBusinessFollowUps         BusinessMatterFollowUp[]      @relation("BusinessFollowUpNextAssignee")
  createdBusinessFinanceRecords     BusinessMatterFinanceRecord[] @relation("BusinessFinanceCreatedBy")
  appliedBusinessFinanceRecords     BusinessMatterFinanceRecord[] @relation("BusinessFinanceApplicant")
  handledBusinessFinanceRecords     BusinessMatterFinanceRecord[] @relation("BusinessFinanceHandler")
  approvedBusinessFinanceRecords    BusinessMatterFinanceRecord[] @relation("BusinessFinanceApprover")
  paidBusinessFinanceRecords        BusinessMatterFinanceRecord[] @relation("BusinessFinancePayer")
  settledBusinessFinanceRecords     BusinessMatterFinanceRecord[] @relation("BusinessFinanceSettlementOwner")
  approvedByBusinessFinanceRecords  BusinessMatterFinanceRecord[] @relation("BusinessFinanceApprovedBy")
  paidByBusinessFinanceRecords      BusinessMatterFinanceRecord[] @relation("BusinessFinancePaidBy")
  rejectedBusinessFinanceRecords    BusinessMatterFinanceRecord[] @relation("BusinessFinanceRejectedBy")
  createdBusinessContracts          BusinessMatterContract[]      @relation("BusinessContractCreatedBy")
  businessActivities                BusinessMatterActivity[]
  createdAssets                     Asset[]                       @relation("AssetCreatedBy")
  ownedAssets                       Asset[]                       @relation("AssetOwner")
  usingAssets                       Asset[]                       @relation("AssetUser")
  submittedAssets                   PendingAsset[]                @relation("PendingAssetSubmittedBy")
  reviewedAssets                    PendingAsset[]                @relation("PendingAssetReviewedBy")
  assetReservations                 AssetReservation[]            @relation("AssetReservationApplicant")
  assetBorrows                      AssetBorrowRecord[]           @relation("AssetBorrowApplicant")
  createdHandovers                  AssetHandoverRecord[]         @relation("AssetHandoverCreatedBy")
  handoversFrom                     AssetHandoverRecord[]         @relation("AssetHandoverFromUser")
  handoversTo                       AssetHandoverRecord[]         @relation("AssetHandoverToUser")
  createdTransfers                  AssetTransfer[]               @relation("AssetTransferCreatedBy")
  transfersFromOwner                AssetTransfer[]               @relation("AssetTransferFromOwner")
  transfersToOwner                  AssetTransfer[]               @relation("AssetTransferToOwner")
  appliedApprovals                  Approval[]                    @relation("ApprovalApplicant")
  assignedApprovals                 Approval[]                    @relation("ApprovalAssignee")
  approvalActions                   ApprovalAction[]              @relation("ApprovalActionActor")
  notifications                     Notification[]                @relation("NotificationRecipient")
  assetEvents                       AssetEvent[]                  @relation("AssetEventActor")
  ownedInventoryTasks               AssetInventoryTask[]          @relation("AssetInventoryOwner")
  createdInventoryTasks             AssetInventoryTask[]          @relation("AssetInventoryCreatedBy")
  checkedInventoryRecords           AssetInventoryRecord[]        @relation("AssetInventoryChecker")
  createdMaintenanceRecords         AssetMaintenanceRecord[]      @relation("AssetMaintenanceCreatedBy")
  assignedAssetAnomalies            AssetAnomaly[]                @relation("AssetAnomalyAssignee")
  requestedAssetExits               AssetExitRequest[]            @relation("AssetExitApplicant")
  auditLogs                         AuditLog[]                    @relation("AuditActor")
  idempotencyRecords                IdempotencyRecord[]

  @@index([organizationId])
  @@map("users")
}

model Organization {
  id                      String                   @id @default(uuid())
  name                    String
  code                    String                   @unique
  enabled                 Boolean                  @default(true)
  createdAt               DateTime                 @default(now()) @map("created_at")
  updatedAt               DateTime                 @updatedAt @map("updated_at")
  deletedAt               DateTime?                @map("deleted_at")
  users                   User[]
  memberships             OrganizationMember[]
  roleBindings            UserRoleBinding[]
  dataScopes              UserDataScope[]
  assetTypes              AssetType[]
  locations               Location[]
  assets                  Asset[]
  pendingAssets           PendingAsset[]
  assetDocumentLinks      AssetDocument[]
  assetReservations       AssetReservation[]
  assetBorrows            AssetBorrowRecord[]
  assetTransfers          AssetTransfer[]
  assetInventoryTasks     AssetInventoryTask[]
  assetMaintenanceRecords AssetMaintenanceRecord[]
  assetAnomalies          AssetAnomaly[]
  assetExitRequests       AssetExitRequest[]
  approvals               Approval[]
  notifications           Notification[]
  assetEvents             AssetEvent[]
  auditLogs               AuditLog[]
  idempotencyRecords      IdempotencyRecord[]

  @@index([enabled])
  @@map("organizations")
}

model OrganizationMember {
  organizationId String       @map("organization_id")
  userId         String       @map("user_id")
  isPrimary      Boolean      @default(true) @map("is_primary")
  createdAt      DateTime     @default(now()) @map("created_at")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([organizationId, userId])
  @@index([userId])
  @@map("organization_members")
}

model Role {
  id          String            @id @default(uuid())
  code        String            @unique
  name        String
  description String?
  builtIn     Boolean           @default(false) @map("built_in")
  createdAt   DateTime          @default(now()) @map("created_at")
  updatedAt   DateTime          @updatedAt @map("updated_at")
  bindings    UserRoleBinding[]
  permissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          String           @id @default(uuid())
  code        String           @unique
  name        String
  module      String
  description String?
  createdAt   DateTime         @default(now()) @map("created_at")
  roleLinks   RolePermission[]

  @@index([module])
  @@map("permissions")
}

model UserRoleBinding {
  organizationId String       @map("organization_id")
  userId         String       @map("user_id")
  roleId         String       @map("role_id")
  createdAt      DateTime     @default(now()) @map("created_at")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           Role         @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([organizationId, userId, roleId])
  @@index([userId])
  @@index([roleId])
  @@map("user_role_bindings")
}

model RolePermission {
  roleId       String     @map("role_id")
  permissionId String     @map("permission_id")
  createdAt    DateTime   @default(now()) @map("created_at")
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model UserDataScope {
  id             String       @id @default(uuid())
  organizationId String       @map("organization_id")
  userId         String       @map("user_id")
  scopeType      String       @map("scope_type")
  scopeId        String       @map("scope_id")
  createdAt      DateTime     @default(now()) @map("created_at")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId, scopeType, scopeId])
  @@index([userId, scopeType])
  @@map("user_data_scopes")
}

model AuthSession {
  id               String    @id @default(uuid())
  userId           String    @map("user_id")
  refreshTokenHash String    @unique @map("refresh_token_hash")
  expiresAt        DateTime  @map("expires_at")
  revokedAt        DateTime? @map("revoked_at")
  userAgent        String?   @map("user_agent")
  ip               String?
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([expiresAt])
  @@map("auth_sessions")
}

model Department {
  id              String           @id @default(uuid())
  name            String
  parentId        String?          @map("parent_id")
  managerNote     String?          @map("manager_note")
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")
  deletedAt       DateTime?        @map("deleted_at")
  parent          Department?      @relation("DepartmentTree", fields: [parentId], references: [id])
  children        Department[]     @relation("DepartmentTree")
  users           User[]
  documents       Document[]
  businessMatters BusinessMatter[]
  assets          Asset[]
  transfersFrom   AssetTransfer[]  @relation("AssetTransferFromDepartment")
  transfersTo     AssetTransfer[]  @relation("AssetTransferToDepartment")

  @@index([parentId])
  @@map("departments")
}

model Category {
  id                   String     @id @default(uuid())
  name                 String
  code                 String?
  parentId             String?    @map("parent_id")
  level                Int
  isSystem             Boolean    @default(false) @map("is_system")
  sort                 Int        @default(0)
  createdAt            DateTime   @default(now()) @map("created_at")
  updatedAt            DateTime   @updatedAt @map("updated_at")
  deletedAt            DateTime?  @map("deleted_at")
  parent               Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children             Category[] @relation("CategoryTree")
  primaryDocuments     Document[] @relation("PrimaryCategory")
  subcategoryDocuments Document[] @relation("Subcategory")

  @@unique([code])
  @@index([parentId])
  @@map("categories")
}

model Tag {
  id           String        @id @default(uuid())
  name         String
  normalized   String        @unique
  createdById  String?       @map("created_by_id")
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")
  deletedAt    DateTime?     @map("deleted_at")
  createdBy    User?         @relation("TagCreatedBy", fields: [createdById], references: [id])
  documentTags DocumentTag[]

  @@map("tags")
}

model Partner {
  id               String            @id @default(uuid())
  companyName      String            @unique @map("company_name")
  type             PartnerType
  contactName      String?           @map("contact_name")
  phone            String?
  email            String?
  address          String?
  remark           String?
  status           PartnerStatus     @default(ACTIVE)
  createdAt        DateTime          @default(now()) @map("created_at")
  updatedAt        DateTime          @updatedAt @map("updated_at")
  deletedAt        DateTime?         @map("deleted_at")
  documentPartners DocumentPartner[]
  businessMatters  BusinessMatter[]

  @@index([type])
  @@index([status])
  @@map("partners")
}

model BusinessMatter {
  id                String                        @id @default(uuid())
  matterNo          String                        @unique @map("matter_no")
  title             String
  type              BusinessMatterType
  status            BusinessMatterStatus          @default(PLANNING)
  parentId          String?                       @map("parent_id")
  ownerId           String                        @map("owner_id")
  ownerName         String?                       @map("owner_name")
  createdById       String                        @map("created_by_id")
  departmentId      String?                       @map("department_id")
  departmentName    String?                       @map("department_name")
  partnerId         String?                       @map("partner_id")
  partnerName       String?                       @map("partner_name")
  startDate         DateTime?                     @map("start_date")
  endDate           DateTime?                     @map("end_date")
  amount            Decimal?                      @db.Decimal(15, 2)
  remark            String?
  createdAt         DateTime                      @default(now()) @map("created_at")
  updatedAt         DateTime                      @updatedAt @map("updated_at")
  deletedAt         DateTime?                     @map("deleted_at")
  parent            BusinessMatter?               @relation("BusinessMatterTree", fields: [parentId], references: [id], onDelete: SetNull)
  children          BusinessMatter[]              @relation("BusinessMatterTree")
  owner             User                          @relation("BusinessMatterOwner", fields: [ownerId], references: [id])
  createdBy         User                          @relation("BusinessMatterCreatedBy", fields: [createdById], references: [id])
  department        Department?                   @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  partner           Partner?                      @relation(fields: [partnerId], references: [id], onDelete: SetNull)
  documents         BusinessMatterDocument[]
  tasks             BusinessMatterTask[]
  stages            BusinessMatterStage[]
  milestones        BusinessMatterMilestone[]
  followUps         BusinessMatterFollowUp[]
  contract          BusinessMatterContract?
  financeRecords    BusinessMatterFinanceRecord[]
  issues            BusinessMatterIssue[]
  activities        BusinessMatterActivity[]
  assets            Asset[]
  assetReservations AssetReservation[]
  assetBorrows      AssetBorrowRecord[]

  @@index([type])
  @@index([status])
  @@index([parentId])
  @@index([ownerId])
  @@index([departmentId])
  @@index([partnerId])
  @@index([deletedAt])
  @@map("business_matters")
}

model AssetType {
  id             String       @id @default(uuid())
  organizationId String       @map("organization_id")
  name           String
  code           String
  parentId       String?      @map("parent_id")
  enabled        Boolean      @default(true)
  fieldSchema    Json         @default("[]") @map("field_schema")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  parent         AssetType?   @relation("AssetTypeTree", fields: [parentId], references: [id], onDelete: SetNull)
  children       AssetType[]  @relation("AssetTypeTree")
  assets         Asset[]

  @@unique([organizationId, code])
  @@index([organizationId, enabled])
  @@index([parentId])
  @@map("asset_types")
}

model Location {
  id               String                 @id @default(uuid())
  organizationId   String                 @map("organization_id")
  name             String
  code             String
  parentId         String?                @map("parent_id")
  enabled          Boolean                @default(true)
  createdAt        DateTime               @default(now()) @map("created_at")
  updatedAt        DateTime               @updatedAt @map("updated_at")
  organization     Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  parent           Location?              @relation("LocationTree", fields: [parentId], references: [id], onDelete: SetNull)
  children         Location[]             @relation("LocationTree")
  assets           Asset[]
  inventoryRecords AssetInventoryRecord[]
  transfersFrom    AssetTransfer[]        @relation("AssetTransferFromLocation")
  transfersTo      AssetTransfer[]        @relation("AssetTransferToLocation")

  @@unique([organizationId, code])
  @@index([organizationId, enabled])
  @@index([parentId])
  @@map("locations")
}

model Asset {
  id                 String                   @id @default(uuid())
  organizationId     String                   @map("organization_id")
  businessMatterId   String?                  @map("business_matter_id")
  assetTypeId        String                   @map("asset_type_id")
  departmentId       String?                  @map("department_id")
  locationId         String?                  @map("location_id")
  assetCode          String                   @map("asset_code")
  name               String
  brand              String?
  model              String?
  serialNumber       String?                  @map("serial_number")
  supplier           String?
  purchaseDate       DateTime?                @map("purchase_date")
  purchaseAmount     Decimal?                 @map("purchase_amount") @db.Decimal(15, 2)
  assetStatus        String                   @default("active") @map("asset_status")
  resourceStatus     String                   @default("available") @map("resource_status")
  ownerUserId        String?                  @map("owner_user_id")
  usingUserId        String?                  @map("using_user_id")
  customFields       Json                     @default("{}") @map("custom_fields")
  description        String?
  source             String                   @default("manual")
  qrToken            String                   @unique @map("qr_token")
  version            Int                      @default(1)
  createdById        String                   @map("created_by")
  createdAt          DateTime                 @default(now()) @map("created_at")
  updatedAt          DateTime                 @updatedAt @map("updated_at")
  archivedAt         DateTime?                @map("archived_at")
  organization       Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  businessMatter     BusinessMatter?          @relation(fields: [businessMatterId], references: [id], onDelete: SetNull)
  assetType          AssetType                @relation(fields: [assetTypeId], references: [id])
  department         Department?              @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  location           Location?                @relation(fields: [locationId], references: [id], onDelete: SetNull)
  owner              User?                    @relation("AssetOwner", fields: [ownerUserId], references: [id], onDelete: SetNull)
  usingUser          User?                    @relation("AssetUser", fields: [usingUserId], references: [id], onDelete: SetNull)
  createdBy          User                     @relation("AssetCreatedBy", fields: [createdById], references: [id])
  identifiers        AssetIdentifier[]
  documents          AssetDocument[]
  reservations       AssetReservation[]
  borrows            AssetBorrowRecord[]
  handovers          AssetHandoverRecord[]
  transfers          AssetTransfer[]
  inventoryRecords   AssetInventoryRecord[]
  maintenanceRecords AssetMaintenanceRecord[]
  anomalies          AssetAnomaly[]
  exitRequests       AssetExitRequest[]
  events             AssetEvent[]

  @@unique([organizationId, assetCode])
  @@unique([organizationId, serialNumber])
  @@index([organizationId, assetStatus, resourceStatus])
  @@index([organizationId, updatedAt])
  @@index([businessMatterId])
  @@index([departmentId])
  @@index([locationId])
  @@map("assets")
}

model AssetIdentifier {
  id             String   @id @default(uuid())
  assetId        String   @map("asset_id")
  identifierType String   @map("identifier_type")
  value          String
  isPrimary      Boolean  @default(false) @map("is_primary")
  createdAt      DateTime @default(now()) @map("created_at")
  asset          Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@unique([identifierType, value])
  @@index([assetId])
  @@map("asset_identifiers")
}

model AssetDocument {
  organizationId String       @map("organization_id")
  assetId        String       @map("asset_id")
  documentId     String       @map("document_id")
  createdAt      DateTime     @default(now()) @map("created_at")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
