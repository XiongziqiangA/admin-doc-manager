generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  EMPLOYEE
}

enum UserStatus {
  ACTIVE
  DISABLED
}

enum PartnerType {
  CUSTOMER
  SUPPLIER
  PARTNER
  OTHER
}

enum PartnerStatus {
  ACTIVE
  DISABLED
}

enum DocumentStatus {
  NORMAL
  ARCHIVED
  DELETED
}

enum DocumentLogAction {
  UPLOAD
  VIEW_DETAIL
  DOWNLOAD
  EDIT_INFO
  UPLOAD_VERSION
  DELETE
  RESTORE
}

enum DocumentLogResult {
  SUCCESS
  FAILURE
}

enum FinancePackageStatus {
  DRAFT
  READY
  EXPORTED
}

enum FinanceAnalysisJobStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
}

enum FinanceSuggestionStatus {
  PENDING
  CONFIRMED
  REJECTED
}

enum FinanceAnalysisSource {
  RULES
  AI
}

enum FinanceMaterialType {
  REIMBURSEMENT_FORM
  INVOICE
  PAYMENT_FORM
  TICKET
  CONTRACT
  BANK_RECEIPT
  OTHER
}

enum BusinessMatterType {
  PROJECT
  CONTRACT
  REIMBURSEMENT
  LOAN
  PROCUREMENT
  OTHER
}

enum BusinessMatterStatus {
  PLANNING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum BusinessTaskStatus {
  TODO
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum BusinessTaskPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum BusinessFollowUpMethod {
  CALL
  WECHAT
  EMAIL
  MEETING
  ONSITE
  OTHER
}

enum BusinessFinanceKind {
  LOAN
  REIMBURSEMENT
}

enum BusinessFinanceStatus {
  DRAFT
  PENDING
  APPROVED
  PAID
  SETTLED
  REJECTED
  CANCELLED
}

enum BusinessContractStatus {
  DRAFT
  ACTIVE
  EXPIRED
  TERMINATED
}

enum BusinessActivityAction {
  MATTER_CREATED
  MATTER_UPDATED
  MATTER_DELETED
  TASK_CREATED
  TASK_UPDATED
  TASK_COMPLETED
  TASK_DELETED
  FOLLOW_UP_CREATED
  CONTRACT_UPDATED
  CONTRACT_DELETED
  FINANCE_CREATED
  FINANCE_UPDATED
  FINANCE_DELETED
  FINANCE_DOCUMENT_ATTACHED
  FINANCE_DOCUMENT_DETACHED
}

model User {
  id                    String                 @id @default(uuid())
  username              String                 @unique
  passwordHash          String                 @map("password_hash")
  realName              String                 @map("real_name")
  role                  UserRole               @default(EMPLOYEE)
  status                UserStatus             @default(ACTIVE)
  departmentId          String?                @map("department_id")
  phone                 String?
  email                 String?
  createdAt             DateTime               @default(now()) @map("created_at")
  updatedAt             DateTime               @updatedAt @map("updated_at")
  deletedAt             DateTime?              @map("deleted_at")
  department            Department?            @relation(fields: [departmentId], references: [id])
  createdTags           Tag[]                  @relation("TagCreatedBy")
  createdDocuments      Document[]             @relation("DocumentCreatedBy")
  uploadedVersions      DocumentVersion[]      @relation("VersionUploadedBy")
  documentLogs          DocumentLog[]
  financePackageTasks   FinancePackageTask[]   @relation("FinancePackageCreatedBy")
  financePackageExports FinancePackageExport[] @relation("FinancePackageExportedBy")
  financeAnalysisJobs   FinanceAnalysisJob[]   @relation("FinanceAnalysisCreatedBy")
  ownedBusinessMatters  BusinessMatter[]      @relation("BusinessMatterOwner")
  createdBusinessMatters BusinessMatter[]     @relation("BusinessMatterCreatedBy")
  assignedBusinessTasks BusinessMatterTask[]  @relation("BusinessTaskAssignee")
  createdBusinessTasks  BusinessMatterTask[]  @relation("BusinessTaskCreatedBy")
  completedBusinessTasks BusinessMatterTask[] @relation("BusinessTaskCompletedBy")
  cancelledBusinessTasks BusinessMatterTask[] @relation("BusinessTaskCancelledBy")
  createdBusinessFollowUps BusinessMatterFollowUp[] @relation("BusinessFollowUpCreatedBy")
  assignedBusinessFollowUps BusinessMatterFollowUp[] @relation("BusinessFollowUpNextAssignee")
  createdBusinessFinanceRecords BusinessMatterFinanceRecord[] @relation("BusinessFinanceCreatedBy")
  appliedBusinessFinanceRecords BusinessMatterFinanceRecord[] @relation("BusinessFinanceApplicant")
  handledBusinessFinanceRecords BusinessMatterFinanceRecord[] @relation("BusinessFinanceHandler")
  approvedBusinessFinanceRecords BusinessMatterFinanceRecord[] @relation("BusinessFinanceApprover")
  paidBusinessFinanceRecords BusinessMatterFinanceRecord[] @relation("BusinessFinancePayer")
  settledBusinessFinanceRecords BusinessMatterFinanceRecord[] @relation("BusinessFinanceSettlementOwner")
  approvedByBusinessFinanceRecords BusinessMatterFinanceRecord[] @relation("BusinessFinanceApprovedBy")
  paidByBusinessFinanceRecords BusinessMatterFinanceRecord[] @relation("BusinessFinancePaidBy")
  rejectedBusinessFinanceRecords BusinessMatterFinanceRecord[] @relation("BusinessFinanceRejectedBy")
  createdBusinessContracts BusinessMatterContract[] @relation("BusinessContractCreatedBy")
  businessActivities    BusinessMatterActivity[]

  @@map("users")
}

model Department {
  id          String       @id @default(uuid())
  name        String
  parentId    String?      @map("parent_id")
  managerNote String?      @map("manager_note")
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")
  deletedAt   DateTime?    @map("deleted_at")
  parent      Department?  @relation("DepartmentTree", fields: [parentId], references: [id])
  children    Department[] @relation("DepartmentTree")
  users       User[]
  documents   Document[]
  businessMatters BusinessMatter[]

  @@index([parentId])
  @@map("departments")
}

model Category {
  id                   String     @id @default(uuid())
  name                 String
  code                 String?
  parentId             String?    @map("parent_id")
  level                Int
  isSystem             Boolean    @default(false) @map("is_system")
  sort                 Int        @default(0)
  createdAt            DateTime   @default(now()) @map("created_at")
  updatedAt            DateTime   @updatedAt @map("updated_at")
  deletedAt            DateTime?  @map("deleted_at")
  parent               Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children             Category[] @relation("CategoryTree")
  primaryDocuments     Document[] @relation("PrimaryCategory")
  subcategoryDocuments Document[] @relation("Subcategory")

  @@unique([code])
  @@index([parentId])
  @@map("categories")
}

model Tag {
  id           String        @id @default(uuid())
  name         String
  normalized   String        @unique
  createdById  String?       @map("created_by_id")
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")
  deletedAt    DateTime?     @map("deleted_at")
  createdBy    User?         @relation("TagCreatedBy", fields: [createdById], references: [id])
  documentTags DocumentTag[]

  @@map("tags")
}

model Partner {
  id               String            @id @default(uuid())
  companyName      String            @unique @map("company_name")
  type             PartnerType
  contactName      String?           @map("contact_name")
  phone            String?
  email            String?
  address          String?
  remark           String?
  status           PartnerStatus     @default(ACTIVE)
  createdAt        DateTime          @default(now()) @map("created_at")
  updatedAt        DateTime          @updatedAt @map("updated_at")
  deletedAt        DateTime?         @map("deleted_at")
  documentPartners DocumentPartner[]
  businessMatters  BusinessMatter[]

  @@index([type])
  @@index([status])
  @@map("partners")
}

model BusinessMatter {
  id          String              @id @default(uuid())
  matterNo    String              @unique @map("matter_no")
  title       String
  type        BusinessMatterType
  status      BusinessMatterStatus @default(PLANNING)
  parentId    String?             @map("parent_id")
  ownerId     String              @map("owner_id")
  ownerName   String?             @map("owner_name")
  createdById String              @map("created_by_id")
  departmentId String?            @map("department_id")
  departmentName String?          @map("department_name")
  partnerId   String?              @map("partner_id")
  partnerName String?             @map("partner_name")
  startDate   DateTime?           @map("start_date")
  endDate     DateTime?           @map("end_date")
  amount      Decimal?            @db.Decimal(15, 2)
  remark      String?
  createdAt   DateTime            @default(now()) @map("created_at")
  updatedAt   DateTime            @updatedAt @map("updated_at")
  deletedAt   DateTime?           @map("deleted_at")
  parent      BusinessMatter?     @relation("BusinessMatterTree", fields: [parentId], references: [id], onDelete: SetNull)
  children    BusinessMatter[]    @relation("BusinessMatterTree")
  owner       User                @relation("BusinessMatterOwner", fields: [ownerId], references: [id])
  createdBy   User                @relation("BusinessMatterCreatedBy", fields: [createdById], references: [id])
  department  Department?         @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  partner     Partner?            @relation(fields: [partnerId], references: [id], onDelete: SetNull)
  documents   BusinessMatterDocument[]
  tasks       BusinessMatterTask[]
  followUps   BusinessMatterFollowUp[]
  contract    BusinessMatterContract?
  financeRecords BusinessMatterFinanceRecord[]
  activities  BusinessMatterActivity[]

  @@index([type])
  @@index([status])
  @@index([parentId])
  @@index([ownerId])
  @@index([departmentId])
  @@index([partnerId])
  @@index([deletedAt])
  @@map("business_matters")
}

model BusinessMatterDocument {
  matterId     String          @map("matter_id")
  documentId   String          @map("document_id")
  versionId    String?         @map("version_id")
  relationType String          @default("REFERENCE") @map("relation_type")
  isPrimary    Boolean         @default(false) @map("is_primary")
  createdAt    DateTime        @default(now()) @map("created_at")
  matter       BusinessMatter  @relation(fields: [matterId], references: [id], onDelete: Cascade)
  document     Document        @relation(fields: [documentId], references: [id], onDelete: Cascade)
  version      DocumentVersion? @relation(fields: [versionId], references: [id], onDelete: SetNull)

  @@id([matterId, documentId])
  @@index([documentId])
  @@index([versionId])
  @@map("business_matter_documents")
}

model BusinessMatterTask {
  id          String               @id @default(uuid())
  matterId    String               @map("matter_id")
  title       String
  description String?              @db.Text
  status      BusinessTaskStatus   @default(TODO)
  priority    BusinessTaskPriority @default(NORMAL)
  progress    Int                  @default(0)
  dueDate     DateTime?            @map("due_date")
  startedAt   DateTime?            @map("started_at")
  completedAt DateTime?            @map("completed_at")
  completedById String?            @map("completed_by_id")
  completionNote String?           @db.Text @map("completion_note")
  cancelledById String?            @map("cancelled_by_id")
  cancellationReason String?       @db.Text @map("cancellation_reason")
  assigneeId  String?              @map("assignee_id")
  createdById String               @map("created_by_id")
  createdAt   DateTime             @default(now()) @map("created_at")
  updatedAt   DateTime             @updatedAt @map("updated_at")
  deletedAt   DateTime?            @map("deleted_at")
  matter      BusinessMatter       @relation(fields: [matterId], references: [id], onDelete: Cascade)
  assignee    User?                @relation("BusinessTaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  createdBy   User                 @relation("BusinessTaskCreatedBy", fields: [createdById], references: [id])
  completedBy User?                @relation("BusinessTaskCompletedBy", fields: [completedById], references: [id], onDelete: SetNull)
  cancelledBy User?                @relation("BusinessTaskCancelledBy", fields: [cancelledById], references: [id], onDelete: SetNull)

  @@index([matterId, status])
  @@index([assigneeId, status])
  @@index([completedById])
  @@index([cancelledById])
  @@index([dueDate])
  @@index([deletedAt])
  @@map("business_matter_tasks")
}

model BusinessMatterFollowUp {
  id             String                  @id @default(uuid())
  matterId       String                  @map("matter_id")
  method         BusinessFollowUpMethod
  content        String                  @db.Text
  result         String?                 @db.Text
  nextAction     String?                 @db.Text @map("next_action")
  nextAssigneeId String?                 @map("next_assignee_id")
  nextDueAt      DateTime?               @map("next_due_at")
  createdById    String                  @map("created_by_id")
  createdAt      DateTime                @default(now()) @map("created_at")
  updatedAt      DateTime                @updatedAt @map("updated_at")
  deletedAt      DateTime?               @map("deleted_at")
  matter         BusinessMatter          @relation(fields: [matterId], references: [id], onDelete: Cascade)
  nextAssignee   User?                   @relation("BusinessFollowUpNextAssignee", fields: [nextAssigneeId], references: [id], onDelete: SetNull)
  createdBy      User                    @relation("BusinessFollowUpCreatedBy", fields: [createdById], references: [id])

  @@index([matterId, createdAt])
  @@index([nextAssigneeId, nextDueAt])
  @@index([nextDueAt])
  @@index([deletedAt])
  @@map("business_matter_follow_ups")
}

model BusinessMatterContract {
  id                String                 @id @default(uuid())
  matterId          String                 @unique @map("matter_id")
  contractNo        String?                @map("contract_no")
  partyName         String                 @map("party_name")
  signedAt          DateTime?              @map("signed_at")
  effectiveAt       DateTime?              @map("effective_at")
  expiresAt         DateTime?              @map("expires_at")
  renewalNoticeDays Int                    @default(30) @map("renewal_notice_days")
  amount            Decimal?               @db.Decimal(15, 2)
  status            BusinessContractStatus @default(DRAFT)
  remark            String?
  createdById       String                 @map("created_by_id")
  createdAt         DateTime               @default(now()) @map("created_at")
  updatedAt         DateTime               @updatedAt @map("updated_at")
  matter            BusinessMatter         @relation(fields: [matterId], references: [id], onDelete: Cascade)
  createdBy         User                   @relation("BusinessContractCreatedBy", fields: [createdById], references: [id])

  @@index([expiresAt, status])
  @@index([createdById])
  @@map("business_matter_contracts")
}

model BusinessMatterFinanceRecord {
  id           String                         @id @default(uuid())
  matterId     String                         @map("matter_id")
  recordNo     String                         @unique @map("record_no")
  kind         BusinessFinanceKind
  status       BusinessFinanceStatus          @default(DRAFT)
  title        String
  amount       Decimal                        @db.Decimal(15, 2)
  currency     String                         @default("CNY")
  applicantId  String?                        @map("applicant_id")
  handlerId    String?                        @map("handler_id")
  approverId   String?                        @map("approver_id")
  payerId      String?                        @map("payer_id")
  settlementOwnerId String?                   @map("settlement_owner_id")
  occurredAt   DateTime?                      @map("occurred_at")
  counterparty String?
  dueDate      DateTime?                      @map("due_date")
  settledAt    DateTime?                      @map("settled_at")
  approvedAt   DateTime?                      @map("approved_at")
  approvedById String?                        @map("approved_by_id")
  paidAt       DateTime?                      @map("paid_at")
  paidById     String?                        @map("paid_by_id")
  rejectedAt   DateTime?                      @map("rejected_at")
  rejectedById String?                        @map("rejected_by_id")
  rejectionReason String?                     @db.Text @map("rejection_reason")
  settlementNote String?                      @db.Text @map("settlement_note")
  remark       String?
  createdById  String                         @map("created_by_id")
  createdAt    DateTime                       @default(now()) @map("created_at")
  updatedAt    DateTime                       @updatedAt @map("updated_at")
  deletedAt    DateTime?                      @map("deleted_at")
  matter       BusinessMatter                 @relation(fields: [matterId], references: [id], onDelete: Cascade)
  createdBy    User                           @relation("BusinessFinanceCreatedBy", fields: [createdById], references: [id])
  applicant    User?                          @relation("BusinessFinanceApplicant", fields: [applicantId], references: [id], onDelete: SetNull)
  handler      User?                          @relation("BusinessFinanceHandler", fields: [handlerId], references: [id], onDelete: SetNull)
  approver     User?                          @relation("BusinessFinanceApprover", fields: [approverId], references: [id], onDelete: SetNull)
  payer        User?                          @relation("BusinessFinancePayer", fields: [payerId], references: [id], onDelete: SetNull)
  settlementOwner User?                      @relation("BusinessFinanceSettlementOwner", fields: [settlementOwnerId], references: [id], onDelete: SetNull)
  approvedBy   User?                          @relation("BusinessFinanceApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)
  paidBy       User?                          @relation("BusinessFinancePaidBy", fields: [paidById], references: [id], onDelete: SetNull)
  rejectedBy   User?                          @relation("BusinessFinanceRejectedBy", fields: [rejectedById], references: [id], onDelete: SetNull)
  documents    BusinessMatterFinanceDocument[]

  @@index([matterId, kind, status])
  @@index([applicantId])
  @@index([handlerId])
  @@index([approverId])
  @@index([payerId])
  @@index([settlementOwnerId])
  @@index([dueDate])
  @@index([deletedAt])
  @@map("business_matter_finance_records")
}

model BusinessMatterFinanceDocument {
  recordId     String                        @map("record_id")
  documentId   String                        @map("document_id")
  versionId    String?                       @map("version_id")
  relationType String                        @default("VOUCHER") @map("relation_type")
  createdAt    DateTime                      @default(now()) @map("created_at")
  record       BusinessMatterFinanceRecord  @relation(fields: [recordId], references: [id], onDelete: Cascade)
  document     Document                      @relation(fields: [documentId], references: [id], onDelete: Cascade)
  version      DocumentVersion?              @relation(fields: [versionId], references: [id], onDelete: SetNull)

  @@id([recordId, documentId])
  @@index([documentId])
  @@index([versionId])
  @@map("business_matter_finance_documents")
}

model BusinessMatterActivity {
  id        String                 @id @default(uuid())
  matterId  String                 @map("matter_id")
  actorId   String                 @map("actor_id")
  action    BusinessActivityAction
  summary   String
  metadata  Json?
  createdAt DateTime               @default(now()) @map("created_at")
  matter    BusinessMatter         @relation(fields: [matterId], references: [id], onDelete: Cascade)
  actor     User                   @relation(fields: [actorId], references: [id])

  @@index([matterId, createdAt])
  @@index([actorId, createdAt])
  @@map("business_matter_activities")
}

model Document {
  id                  String                 @id @default(uuid())
  title               String
  documentNo          String                 @unique @map("document_no")
  categoryId          String                 @map("category_id")
  subcategoryId       String?                @map("subcategory_id")
  departmentId        String?                @map("department_id")
  status              DocumentStatus         @default(NORMAL)
  creatorId           String                 @map("creator_id")
  remark              String?
  currentVersionId    String?                @unique @map("current_version_id")
  createdAt           DateTime               @default(now()) @map("created_at")
  updatedAt           DateTime               @updatedAt @map("updated_at")
  deletedAt           DateTime?              @map("deleted_at")
  category            Category               @relation("PrimaryCategory", fields: [categoryId], references: [id])
  subcategory         Category?              @relation("Subcategory", fields: [subcategoryId], references: [id])
  department          Department?            @relation(fields: [departmentId], references: [id])
  creator             User                   @relation("DocumentCreatedBy", fields: [creatorId], references: [id])
  currentVersion      DocumentVersion?       @relation("CurrentDocumentVersion", fields: [currentVersionId], references: [id])
  versions            DocumentVersion[]      @relation("DocumentVersions")
  documentTags        DocumentTag[]
  documentPartners    DocumentPartner[]
  contentIndexes      DocumentContentIndex[]
  analyses            DocumentAnalysis[]
  logs                DocumentLog[]
  financePackageItems FinancePackageItem[]
  financePackageSuggestions FinancePackageSuggestion[]
  businessMatterLinks BusinessMatterDocument[]
  businessFinanceDocumentLinks BusinessMatterFinanceDocument[]

  @@index([categoryId])
  @@index([subcategoryId])
  @@index([departmentId])
  @@index([creatorId])
  @@index([status])
  @@map("documents")
}

model DocumentVersion {
  id                  String                @id @default(uuid())
  documentId          String                @map("document_id")
  versionNo           String                @map("version_no")
  versionLabel        String                @map("version_label")
  originalFileName    String                @map("original_file_name")
  storageKey          String                @map("storage_key")
  fileSize            Int                   @map("file_size")
  mimeType            String                @map("mime_type")
  fileExt             String                @map("file_ext")
  checksum            String
  uploadUserId        String                @map("upload_user_id")
  changeNote          String?               @map("change_note")
  createdAt           DateTime              @default(now()) @map("created_at")
  document            Document              @relation("DocumentVersions", fields: [documentId], references: [id])
  currentFor          Document?             @relation("CurrentDocumentVersion")
  uploadUser          User                  @relation("VersionUploadedBy", fields: [uploadUserId], references: [id])
  contentIndex        DocumentContentIndex?
  analysis            DocumentAnalysis?
  logs                DocumentLog[]
  financePackageItems FinancePackageItem[]
  financePackageSuggestions FinancePackageSuggestion[]
  businessMatterLinks BusinessMatterDocument[]
  businessFinanceDocumentLinks BusinessMatterFinanceDocument[]

  @@unique([documentId, versionNo])
  @@index([documentId])
  @@index([uploadUserId])
  @@map("document_versions")
}

model DocumentContentIndex {
  id             String    @id @default(uuid())
  documentId     String    @map("document_id")
  versionId      String    @unique @map("version_id")
  extractedText  String    @map("extracted_text") @db.Text
  textLength     Int       @map("text_length")
  parser         String
  status         String
  embedding      Json?
  embeddingModel String?   @map("embedding_model")
  errorMessage   String?   @map("error_message") @db.Text
  indexedAt      DateTime? @map("indexed_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  document Document        @relation(fields: [documentId], references: [id], onDelete: Cascade)
  version  DocumentVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)

  @@index([documentId])
  @@index([status])
  @@map("document_content_indexes")
}

model DocumentTag {
  documentId String   @map("document_id")
  tagId      String   @map("tag_id")
  document   Document @relation(fields: [documentId], references: [id])
  tag        Tag      @relation(fields: [tagId], references: [id])

  @@id([documentId, tagId])
  @@map("document_tags")
}

model DocumentPartner {
  documentId String   @map("document_id")
  partnerId  String   @map("partner_id")
  document   Document @relation(fields: [documentId], references: [id])
  partner    Partner  @relation(fields: [partnerId], references: [id])

  @@id([documentId, partnerId])
  @@map("document_partners")
}

model DocumentLog {
  id         String            @id @default(uuid())
  documentId String            @map("document_id")
  versionId  String?           @map("version_id")
  userId     String            @map("user_id")
  action     DocumentLogAction
  ip         String?
  userAgent  String?           @map("user_agent")
  result     DocumentLogResult @default(SUCCESS)
  createdAt  DateTime          @default(now()) @map("created_at")
  document   Document          @relation(fields: [documentId], references: [id])
  version    DocumentVersion?  @relation(fields: [versionId], references: [id])
  user       User              @relation(fields: [userId], references: [id])

  @@index([documentId])
  @@index([versionId])
  @@index([userId])
  @@index([action])
  @@index([createdAt])
  @@map("document_logs")
}

model FinancePackageTask {
  id              String                 @id @default(uuid())
  name            String
  period          String
  rootFolderName  String                 @map("root_folder_name")
  status          FinancePackageStatus   @default(DRAFT)
  includeManifest Boolean                @default(true) @map("include_manifest")
  createdById     String                 @map("created_by_id")
  lastExportedAt  DateTime?              @map("last_exported_at")
  createdAt       DateTime               @default(now()) @map("created_at")
  updatedAt       DateTime               @updatedAt @map("updated_at")
  createdBy       User                   @relation("FinancePackageCreatedBy", fields: [createdById], references: [id])
  groups          FinancePackageGroup[]
  items           FinancePackageItem[]
  exports         FinancePackageExport[]
  analysisJobs    FinanceAnalysisJob[]

  @@index([period])
  @@index([status])
  @@index([createdById])
  @@map("finance_package_tasks")
}

model FinancePackageGroup {
  id        String                @id @default(uuid())
  taskId    String                @map("task_id")
  name      String
  parentId  String?               @map("parent_id")
  sort      Int                   @default(0)
  createdAt DateTime              @default(now()) @map("created_at")
  updatedAt DateTime              @updatedAt @map("updated_at")
  task      FinancePackageTask    @relation(fields: [taskId], references: [id], onDelete: Cascade)
  parent    FinancePackageGroup?  @relation("FinancePackageGroupTree", fields: [parentId], references: [id], onDelete: Cascade)
  children  FinancePackageGroup[] @relation("FinancePackageGroupTree")
  items     FinancePackageItem[]

  @@index([taskId, sort])
  @@index([parentId])
  @@map("finance_package_groups")
}

model FinancePackageItem {
  id             String               @id @default(uuid())
  taskId         String               @map("task_id")
  groupId        String?              @map("group_id")
  documentId     String               @map("document_id")
  versionId      String               @map("version_id")
  materialType   FinanceMaterialType  @default(OTHER) @map("material_type")
  exportFileName String?              @map("export_file_name")
  sort           Int                  @default(0)
  remark         String?
  createdAt      DateTime             @default(now()) @map("created_at")
  updatedAt      DateTime             @updatedAt @map("updated_at")
  task           FinancePackageTask   @relation(fields: [taskId], references: [id], onDelete: Cascade)
  group          FinancePackageGroup? @relation(fields: [groupId], references: [id], onDelete: Cascade)
  document       Document             @relation(fields: [documentId], references: [id], onDelete: Cascade)
  version        DocumentVersion      @relation(fields: [versionId], references: [id], onDelete: Cascade)

  @@unique([taskId, documentId])
  @@index([taskId, groupId, sort])
  @@index([documentId])
  @@index([versionId])
  @@map("finance_package_items")
}

model FinancePackageExport {
  id           String             @id @default(uuid())
  taskId       String             @map("task_id")
  exportedById String             @map("exported_by_id")
  fileName     String             @map("file_name")
  fileCount    Int                @map("file_count")
  createdAt    DateTime           @default(now()) @map("created_at")
  task         FinancePackageTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  exportedBy   User               @relation("FinancePackageExportedBy", fields: [exportedById], references: [id])

  @@index([taskId, createdAt])
  @@index([exportedById])
  @@map("finance_package_exports")
}

model DocumentAnalysis {
  id              String                @id @default(uuid())
  documentId      String                @map("document_id")
  versionId       String                @unique @map("version_id")
  source          FinanceAnalysisSource
  status          String
  extractedFields Json                  @map("extracted_fields")
  confidence      Float?
  provider        String?
  model           String?
  promptVersion   String?               @map("prompt_version")
  errorMessage    String?               @map("error_message") @db.Text
  createdAt       DateTime              @default(now()) @map("created_at")
  updatedAt       DateTime              @updatedAt @map("updated_at")
  document        Document              @relation(fields: [documentId], references: [id], onDelete: Cascade)
  version         DocumentVersion       @relation(fields: [versionId], references: [id], onDelete: Cascade)

  @@index([documentId])
  @@index([status])
  @@map("document_analyses")
}

model FinanceAnalysisJob {
  id              String                   @id @default(uuid())
  taskId          String                   @map("task_id")
  createdById     String                   @map("created_by_id")
  status          FinanceAnalysisJobStatus @default(PENDING)
  totalCount      Int                      @default(0) @map("total_count")
  processedCount  Int                      @default(0) @map("processed_count")
  requestCount    Int                      @default(0) @map("request_count")
  inputTokens     Int?                     @map("input_tokens")
  outputTokens    Int?                    @map("output_tokens")
  totalTokens     Int?                    @map("total_tokens")
  durationMs      Int?                    @map("duration_ms")
  provider        String?
  model           String?
  promptVersion   String?                  @map("prompt_version")
  errorMessage    String?                  @map("error_message") @db.Text
  startedAt       DateTime?                @map("started_at")
  completedAt     DateTime?                @map("completed_at")
  createdAt       DateTime                 @default(now()) @map("created_at")
  updatedAt       DateTime                 @updatedAt @map("updated_at")
  task            FinancePackageTask       @relation(fields: [taskId], references: [id], onDelete: Cascade)
  createdBy       User                     @relation("FinanceAnalysisCreatedBy", fields: [createdById], references: [id])
  suggestions     FinancePackageSuggestion[]

  @@index([taskId, createdAt])
  @@index([status])
  @@index([createdById])
  @@map("finance_analysis_jobs")
}

model AiProviderSetting {
  id               String   @id @default("default")
  enabled          Boolean  @default(false)
  baseUrl          String   @map("base_url")
  model            String
  apiKeyEncrypted  String?  @map("api_key_encrypted") @db.Text
  lastTestAt       DateTime? @map("last_test_at")
  lastTestOk       Boolean?  @map("last_test_ok")
  lastTestMessage  String?   @map("last_test_message") @db.Text
  lastTestStatus   String?   @map("last_test_status")
  lastTestModel    String?   @map("last_test_model")
  lastTestDuration Int?      @map("last_test_duration_ms")
  lastTestEndpoint String?   @map("last_test_endpoint")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  @@map("ai_provider_settings")
}

model FinancePackageSuggestion {
  id                  String                  @id @default(uuid())
  jobId               String                  @map("job_id")
  documentId          String                  @map("document_id")
  versionId           String                  @map("version_id")
  suggestedGroupName  String                  @map("suggested_group_name")
  suggestedFileName   String                  @map("suggested_file_name")
  materialType        FinanceMaterialType     @default(OTHER) @map("material_type")
  extractedFields     Json                    @map("extracted_fields")
  groupingKey         String?                 @map("grouping_key")
  confidence          Float?
  reasons             Json
  status              FinanceSuggestionStatus @default(PENDING)
  confirmedGroupId    String?                 @map("confirmed_group_id")
  confirmedAt         DateTime?               @map("confirmed_at")
  createdAt           DateTime                @default(now()) @map("created_at")
  updatedAt           DateTime                @updatedAt @map("updated_at")
  job                 FinanceAnalysisJob      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  document            Document                @relation(fields: [documentId], references: [id], onDelete: Cascade)
  version             DocumentVersion         @relation(fields: [versionId], references: [id], onDelete: Cascade)

  @@unique([jobId, documentId])
  @@index([jobId, status])
  @@index([documentId])
  @@index([versionId])
  @@map("finance_package_suggestions")
}
