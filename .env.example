NODE_ENV=development

POSTGRES_DB=admin_docs
POSTGRES_USER=admin_docs
POSTGRES_PASSWORD=change_me
DATABASE_URL=postgresql://admin_docs:change_me@postgres:5432/admin_docs?schema=public

JWT_SECRET=change_me_to_a_long_random_secret
JWT_EXPIRES_IN=8h
ALLOWED_ORIGINS=http://localhost:5173

ADMIN_USERNAME=admin
ADMIN_PASSWORD=ChangeMe123!
ADMIN_REAL_NAME=系统管理员

BACKEND_PORT=3000
FRONTEND_PORT=8080
STORAGE_ROOT=/app/storage
MAX_UPLOAD_SIZE=

# Optional semantic retrieval. Keep disabled to use local keyword search only.
CONTENT_INDEX_MAX_CHARS=500000
AI_SEARCH_ENABLED=false
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
FINANCE_AI_ENABLED=false
OPENAI_MODEL=gpt-4o-mini
FINANCE_AI_TIMEOUT_MS=60000
FINANCE_AI_MAX_OUTPUT_TOKENS=1800
FINANCE_AI_MAX_DOCUMENTS=500
FINANCE_AI_MAX_INPUT_CHARS=12000
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_MAX_INPUT_CHARS=8000
