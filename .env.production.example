NODE_ENV=production
COMPOSE_PROJECT_NAME=admin-docs-prod

POSTGRES_DB=admin_docs_prod
POSTGRES_USER=admin_docs_prod
POSTGRES_PASSWORD=REPLACE_WITH_LONG_RANDOM_DATABASE_PASSWORD
DATABASE_URL=postgresql://admin_docs_prod:REPLACE_WITH_LONG_RANDOM_DATABASE_PASSWORD@postgres:5432/admin_docs_prod?schema=public

JWT_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
JWT_EXPIRES_IN=8h

FRONTEND_PORT=8080
BACKEND_PORT=3000
ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

ADMIN_USERNAME=REPLACE_WITH_ADMIN_USERNAME
ADMIN_PASSWORD=REPLACE_WITH_STRONG_ADMIN_PASSWORD
ADMIN_REAL_NAME=System Administrator
SEED_ADMIN_OVERWRITE=false

STORAGE_ROOT=/app/storage
# Optional absolute host paths for using an existing database and file store.
# Leave these at their defaults for a new deployment.
POSTGRES_DATA_DIR=./data/postgres
STORAGE_DATA_DIR=./data/storage
MAX_UPLOAD_SIZE=
CONTENT_INDEX_MAX_CHARS=500000
AI_SEARCH_ENABLED=false
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
FINANCE_AI_ENABLED=false
OPENAI_MODEL=gpt-4o-mini
FINANCE_AI_TIMEOUT_MS=60000
FINANCE_AI_MAX_OUTPUT_TOKENS=1800
FINANCE_AI_MAX_DOCUMENTS=500
FINANCE_AI_MAX_INPUT_CHARS=12000
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_MAX_INPUT_CHARS=8000
